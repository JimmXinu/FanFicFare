msgstr "Šta uraditi ako već postoji priča sa istim URL-om u antologiji."

#: dialogs.py:522
msgid "Story URLs, one per line:"
msgstr "URL-ovi priča, jedan po liniji:"

#: dialogs.py:523
msgid ""
"URLs for stories, one per line.\n"
"Will take URLs from clipboard, but only valid URLs.\n"
"Add [1,5] after the URL to limit the download to chapters 1-5."
msgstr "URL adrese priča, po jedna u svakom redu.\nIz privremene memorije preuzeće se samo važeće URL adrese.\nDodajte [1,5] posle URL adrese da ograničite preuzimanje na poglavlja 1–5."

#: dialogs.py:524
