msgstr "Da li ste sigurni da želite da uklonite ovaj URL sa liste?"

#: dialogs.py:1306
msgid "Are you sure you want to remove the %d selected URLs from the list?"
msgstr "Da li ste sigurni da želite da uklonite %d izabranih URL-ova sa liste?"

#: dialogs.py:1324
msgid "List of Books to Reject"
msgstr "Lista knjiga za odbijanje"

#: dialogs.py:1337
msgid ""
"FFF will remember these URLs and display the note and offer to reject them "
"if you try to download them again later."
msgstr "FFF će zapamtiti ove URL-ove i prikazati napomenu i ponuditi da ih odbije ako pokušate da ih ponovo preuzmete kasnije."

#: dialogs.py:1351
msgid "Remove selected URLs from the list"
msgstr "Ukloni izabrane URL-ove sa liste"

#: dialogs.py:1366 dialogs.py:1370
msgid "This will be added to whatever note you've set for each URL above."
msgstr "Ovo će biti dodato bilo kojoj napomeni koju ste postavili za svaki URL iznad."

#: dialogs.py:1383
