#: __init__.py:48
msgid "UI plugin to download FanFiction stories from various sites."
msgstr "Dodatak za preuzimanje fanovskih priča sa različitih sajtova."

#: __init__.py:132
msgid ""
"Path to the calibre library. Default is to use the path stored in the "
"settings."
msgstr "Putanja do calibre biblioteke. Podrazumevano je korišćenje putanje sačuvane u podešavanjima."

#: common_utils.py:284
msgid "Keyboard shortcuts"
msgstr "Prečice na tastaturi"

#: common_utils.py:313
msgid "Prefs Viewer dialog"
msgstr "Dijalog pregledača podešavanja"

#: common_utils.py:314
msgid "Preferences for: "
msgstr "Podešavanja za: "

#: common_utils.py:345
msgid "Clear"
msgstr "Obriši"

#: common_utils.py:347
msgid "Clear all settings for this plugin"
msgstr "Obriši sva podešavanja ovog dodatka"

#: common_utils.py:351 config.py:847
msgid "Edit"
msgstr "Uredi"

#: common_utils.py:353
msgid "Edit settings."
msgstr "Uredi podešavanja."

#: common_utils.py:356
msgid "Save"
msgstr "Sačuvaj"

#: common_utils.py:358
msgid "Save setting for this plugin"
msgstr "Sačuvaj podešavanje za ovaj dodatak"

#: common_utils.py:386
msgid ""
"Are you sure you want to edit settings in this library for this plugin?"
msgstr "Da li ste sigurni da želite da uredite podešavanja u ovoj biblioteci za ovaj dodatak?"

#: common_utils.py:387
msgid "The FanFicFare team does not support hand edited configurations."
msgstr "FanFicFare tim ne podržava ručno uređene konfiguracije."

#: common_utils.py:395
msgid ""
"Are you sure you want to save this setting in this library for this plugin?"
msgstr "Da li ste sigurni da želite da sačuvate ovo podešavanje u ovoj biblioteci za ovaj dodatak?"

#: common_utils.py:396 common_utils.py:424
msgid ""
"Any settings in other libraries or stored in a JSON file in your calibre "
"plugins folder will not be touched."
msgstr "Podešavanja u drugim bibliotekama, kao ni ona sačuvana u JSON datoteci u fascikli dodataka za calibre, neće biti promenjena."

#: common_utils.py:397 common_utils.py:425
msgid "You must restart calibre afterwards."
msgstr "Nakon toga morate ponovo pokrenuti calibre."

#: common_utils.py:405
msgid "All settings for this plugin in this library have been saved."
msgstr "Sva podešavanja za ovaj dodatak u ovoj biblioteci su sačuvana."

#: common_utils.py:406 common_utils.py:435
msgid "Please restart calibre now."
msgstr "Ponovo pokrenite calibre sada."

#: common_utils.py:408 common_utils.py:437
msgid "Restart calibre now"
msgstr "Ponovo pokreni calibre sada"

#: common_utils.py:423
msgid ""
"Are you sure you want to clear your settings in this library for this "
"plugin?"
msgstr "Da li ste sigurni da želite da obrišete podešavanja ovog dodatka u ovoj biblioteci?"

#: common_utils.py:434
msgid "All settings for this plugin in this library have been cleared."
msgstr "Sva podešavanja ovog dodatka u ovoj biblioteci su obrisana."

#: config.py:222
msgid "List of Supported Sites"
msgstr "Lista podržanih sajtova"

#: config.py:224
msgid "FAQs"
msgstr "ČPP"

#: config.py:239
msgid "Basic"
msgstr "Osnovno"

#: config.py:250
msgid "Calibre Cover"
msgstr "Calibre korice"

#: config.py:258
msgid "Standard Columns"
msgstr "Standardne kolone"

#: config.py:261
msgid "Custom Columns"
msgstr "Prilagođene kolone"

#: config.py:264
msgid "Email Settings"
msgstr "Podešavanja e-pošte"

#: config.py:267
msgid "Other"
msgstr "Ostalo"

#: config.py:446
msgid ""
"These settings control the basic features of the plugin--downloading "
"FanFiction."
msgstr "Ova podešavanja upravljaju osnovnim funkcijama dodatka — preuzimanjem fanovskih priča."

#: config.py:450
msgid "Defaults Options on Download"
msgstr "Podrazumevane opcije pri preuzimanju"

#: config.py:454
msgid ""
"On each download, FanFicFare offers an option to select the output format. "
"<br />This sets what that option will default to."
msgstr "Pri svakom preuzimanju FanFicFare omogućava izbor izlaznog formata. <br />Ovde se određuje podrazumevana vrednost te opcije."

#: config.py:456
msgid "Default Output &Format:"
msgstr "Podrazumevani izlazni &format:"

#: config.py:471
msgid ""
"On each download, FanFicFare offers an option of what happens if that story "
"already exists. <br />This sets what that option will default to."
msgstr "Pri svakom preuzimanju FanFicFare pita šta da uradi ako priča već postoji. <br />Ovde se određuje podrazumevani izbor."

#: config.py:473
msgid "Default If Story Already Exists?"
msgstr "Podrazumevano ako priča već postoji?"

#: config.py:488
msgid "Default Update Calibre &Metadata?"
msgstr "Podrazumevano ažuriranje Calibre &metapodataka?"

#: config.py:489
msgid ""
"On each download, FanFicFare offers an option to update Calibre's metadata "
"(title, author, URL, tags, custom columns, etc) from the web site. <br "
"/>This sets whether that will default to on or off. <br />Columns set to "
"'New Only' in the column tabs will only be set for new books."
msgstr "Pri svakom preuzimanju FanFicFare može da ažurira metapodatke u programu calibre (naslov, autora, URL, oznake, prilagođene kolone itd.) podacima sa sajta. <br />Ovde birate da li je ta opcija podrazumevano uključena. <br />Kolone označene sa „Samo za nove“ popunjavaju se samo za nove knjige."

#: config.py:493
msgid "Default Background Metadata?"
msgstr "Podrazumevani metapodaci u pozadini?"

#: config.py:494
msgid ""
"On each download, FanFicFare offers an option to Collect Metadata from sites"
" in a Background process.<br />This returns control to you quicker while "
"updating, but you won't be asked for username/passwords or if you are an "
"adult--stories that need those will just fail.<br />Only available for "
"Update/Overwrite of existing books in case URL given isn't canonical or "
"matches to existing book by Title/Author."
msgstr "Pri svakom preuzimanju FanFicFare može da prikuplja metapodatke sa sajtova u pozadini.<br />Tako možete ranije nastaviti rad, ali dodatak neće tražiti korisničko ime, lozinku ni potvrdu punoletstva; preuzimanje priča kojima su ti podaci potrebni neće uspeti.<br />Opcija je dostupna samo pri ažuriranju ili zameni postojećih knjiga kada dati URL nije kanonski ili se knjiga poklapa po naslovu i autoru."

#: config.py:500
msgid "Updating Calibre Options"
msgstr "Opcije ažuriranja Calibre-a"

#: config.py:504
msgid "Delete other existing formats?"
msgstr "Izbrisati druge postojeće formate?"

#: config.py:505
msgid ""
"Check this to automatically delete all other ebook formats when updating an existing book.\n"
"Handy if you have both a Nook(epub) and Kindle(mobi), for example."
msgstr "Označite ovu opciju da biste pri ažuriranju postojeće knjige automatski izbrisali sve njene druge formate.\nKorisno je, na primer, ako imate i Nook (EPUB) i Kindle (MOBI) izdanje."

#: config.py:509
msgid "Keep Existing Tags when Updating Metadata?"
msgstr "Zadržati postojeće oznake pri ažuriranju metapodataka?"

#: config.py:510
msgid ""
"Existing tags will be kept and any new tags added.\n"
"%(cmplt)s and %(inprog)s tags will be still be updated, if known.\n"
"%(lul)s tags will be updated if %(lus)s in %(is)s.\n"
"(If Tags is set to 'New Only' in the Standard Columns tab, this has no effect.)"
msgstr "Postojeće oznake biće zadržane, a nove dodate.\nOznake %(cmplt)s i %(inprog)s i dalje će se ažurirati ako su poznate.\nOznake %(lul)s ažuriraće se ako je %(lus)s u %(is)s.\n(Ako su oznake podešene na „Samo za nove“ na kartici Standardne kolone, ova opcija nema efekta.)"

#: config.py:514
msgid "Check for existing Series Anthology books?"
msgstr "Proveriti postojeće knjige antologije serijala?"

#: config.py:515
msgid ""
"Check for existing Series Anthology books using each new story's series URL before downloading.\n"
"Offer to skip downloading if a Series Anthology is found.\n"
"Doesn't work when Collect Metadata in Background is selected."
msgstr "Pre preuzimanja proveri, prema URL-u serijala svake nove priče, da li već postoji antologija tog serijala.\nAko postoji, ponudi preskakanje preuzimanja.\nNe radi kada je uključeno prikupljanje metapodataka u pozadini."

#: config.py:519 config.py:691
msgid "Reject Without Confirmation?"
msgstr "Odbiti bez potvrde?"

#: config.py:520
msgid ""
"Automatically reject storys with existing Series Anthology books.\n"
"Only works if 'Check for existing Series Anthology books' is on.\n"
"Doesn't work when Collect Metadata in Background is selected."
msgstr "Automatski odbij priče za koje već postoji antologija serijala.\nRadi samo ako je uključena provera postojećih antologija serijala.\nNe radi kada je uključeno prikupljanje metapodataka u pozadini."

#: config.py:524
msgid "Mark Matching Anthologies?"
msgstr "Označiti podudarne antologije?"

#: config.py:525
msgid ""
"Mark and show existing Series Anthology books when individual updates are skipped.\n"
"Only works if 'Check for existing Series Anthology books' is on.\n"
"Doesn't work when Collect Metadata in Background is selected."
msgstr "Označi i prikaži postojeće antologije serijala kada se pojedinačna ažuriranja preskoče.\nRadi samo ako je uključena provera postojećih antologija serijala.\nNe radi kada je uključeno prikupljanje metapodataka u pozadini."

#: config.py:543
msgid "Check for changed Story URL?"
msgstr "Proveriti promenjeni URL priče?"

#: config.py:544
msgid ""
"Warn you if an update will change the URL of an existing book(normally automatic and silent).\n"
"URLs may be changed from http to https silently if the site changed."
msgstr "Upozorava vas ako će ažuriranje promeniti URL postojeće knjige (obično automatski i tiho).\nURL-ovi se mogu tiho promeniti sa http na https ako se sajt promenio."

#: config.py:548
msgid "Search inside ebooks for Story URL?"
msgstr "Pretražiti unutar e-knjiga za URL priče?"

#: config.py:549
msgid ""
"Look for first valid story URL inside EPUB, ZIP(HTML) or TXT ebook formats if not found in metadata.\n"
"Somewhat risky, could find wrong URL depending on ebook content."
msgstr "Potražite prvi važeći URL priče unutar EPUB, ZIP(HTML) ili TXT formata e-knjiga ako nije pronađen u metapodacima.\nDonekle rizično, može pronaći pogrešan URL u zavisnosti od sadržaja e-knjige."

#: config.py:553
msgid "Post Processing Options"
msgstr "Opcije naknadne obrade"

#: config.py:557
msgid "Mark added/updated books when finished?"
msgstr "Označiti dodate/ažurirane knjige po završetku?"

#: config.py:558
msgid ""
"Mark added/updated books when finished.  Use with option below.\n"
"You can also manually search for 'marked:fff_success'.\n"
"'marked:fff_failed' and 'marked:fff_chapter_error' are also available, or search 'marked:fff' for all."
msgstr "Označite dodate/ažurirane knjige po završetku. Koristite sa opcijom ispod.\nMožete i ručno pretraživati 'marked:fff_success'.\n'marked:fff_failed' i 'marked:fff_chapter_error' su takođe dostupni, ili pretražite 'marked:fff' za sve."

#: config.py:566
msgid "Success"
msgstr "Uspeh"

#: config.py:567
msgid "Mark successfully downloaded or updated books."
msgstr "Označite uspešno preuzete ili ažurirane knjige."

#: config.py:572
msgid "Failed"
msgstr "Neuspešno"

#: config.py:573
msgid "Mark failed downloaded or updated books."
msgstr "Označite neuspešno preuzete ili ažurirane knjige."

#: config.py:578
msgid "Chapter Error"
msgstr "Greška u poglavlju"

#: config.py:579
msgid ""
"Mark downloaded or updated books with chapter errors (only when "
"<i>continue_on_chapter_error:true</i>)."
msgstr "Označite preuzete ili ažurirane knjige sa greškama u poglavljima (samo kada je <i>continue_on_chapter_error:true</i>)."

#: config.py:591
msgid "Show Marked books when finished?"
msgstr "Prikazati označene knjige po završetku?"

#: config.py:592
msgid ""
"Show Marked added/updated books only when finished.\n"
"You can also manually search for 'marked:fff_success'.\n"
"'marked:fff_failed' and 'marked:fff_chapter_error' are also available, or search 'marked:fff' for all."
msgstr "Prikažite označene dodate/ažurirane knjige samo po završetku.\nMožete i ručno pretraživati 'marked:fff_success'.\n'marked:fff_failed' i 'marked:fff_chapter_error' su takođe dostupni, ili pretražite 'marked:fff' za sve."

#: config.py:596
msgid "Smarten Punctuation (EPUB only)"
msgstr "Pametna interpunkcija (samo EPUB)"

#: config.py:597
msgid ""
"Run Smarten Punctuation from Calibre's Polish Book feature on each EPUB "
"download and update."
msgstr "Pokrenite Pametnu interpunkciju iz Calibre funkcije Poliranje knjige pri svakom preuzimanju i ažuriranju EPUB-a."

#: config.py:602
msgid ""
"Calculate Word Counts using Calibre internal methods.\n"
"Many sites include Word Count, but many do not.\n"
"This will count the words in each book and include it as if it came from the site."
msgstr "Izračunajte broj reči koristeći Calibre interne metode.\nMnogi sajtovi uključuju broj reči, ali mnogi ne.\nOvo će prebrojati reči u svakoj knjizi i uključiti ih kao da su došle sa sajta."

#: config.py:606
msgid "Calculate Word Count:"
msgstr "Izračunaj broj reči:"

#: config.py:619
msgid "Automatically Convert new/update books?"
msgstr "Automatski konvertovati nove/ažurirane knjige?"

#: config.py:620
msgid ""
"Automatically call calibre's Convert for new/update books.\n"
"Converts to the current output format as chosen in calibre's\n"
"Preferences->Behavior settings."
msgstr "Automatski pozovite calibre Konvertovanje za nove/ažurirane knjige.\nKonvertuje u trenutni izlazni format izabran u calibre\nPodešavanja->Ponašanje."

#: config.py:624
msgid "GUI Options"
msgstr "GUI opcije"

#: config.py:628
msgid "Take URLs from Clipboard?"
msgstr "Preuzeti URL adrese iz privremene memorije?"

#: config.py:629
msgid "Prefill URLs from valid URLs in Clipboard when Adding New."
msgstr "Pri dodavanju nove priče unapred unesite važeće URL adrese iz privremene memorije."

#: config.py:633
msgid "FanFicFare button opens menu?"
msgstr "FanFicFare dugme otvara meni?"

#: config.py:634
msgid ""
"The FanFicFare toolbar button will bring up the plugin menu.  If unchecked, "
"it will <i>Download from URLs</i> or optionally Update, see below."
msgstr "Dugme FanFicFare na traci sa alatkama će otvoriti meni dodatka. Ako nije označeno, izvršiće <i>Preuzimanje sa URL-ova</i> ili opciono Ažuriranje, pogledajte ispod."

#: config.py:638
msgid "Default to Update when books selected?"
msgstr "Podrazumevano na Ažuriranje kada su knjige izabrane?"

#: config.py:639
msgid ""
"The FanFicFare toolbar button will Update if books are selected.  If "
"unchecked, it will always <i>Download from URLs</i>."
msgstr "Dugme FanFicFare na traci sa alatkama će ažurirati ako su knjige izabrane. Ako nije označeno, uvek će izvršiti <i>Preuzimanje sa URL-ova</i>."

#: config.py:648
msgid "Keep 'Add New from URL(s)' dialog on top?"
msgstr "Zadržati dijalog 'Dodaj novo sa URL-a(ova)' na vrhu?"

#: config.py:649
msgid ""
"Instructs the OS and Window Manager to keep the 'Add New from URL(s)'\n"
"dialog on top of all other windows.  Useful for dragging URLs onto it."
msgstr "Nalaže OS-u i menadžeru prozora da zadrže dijalog 'Dodaj novo sa URL-a(ova)'\nna vrhu svih ostalih prozora. Korisno za prevlačenje URL-ova na njega."

#: config.py:653
msgid "Show estimated time left?"
msgstr "Prikazati procenjeno preostalo vreme?"

#: config.py:654
msgid "When a Progress Bar is shown, show a rough estimate of the time left."
msgstr "Kada je prikazana traka napretka, prikažite grubu procenu preostalog vremena."

#: config.py:658
msgid "Misc Options"
msgstr "Razne opcije"

#: config.py:662
msgid "Inject calibre Series when none found?"
msgstr "Ubaciti calibre serijal kada nijedan nije pronađen?"

#: config.py:663
msgid ""
"If no series is found, inject the calibre series (if there is one) so \n"
"it appears on the FanFicFare title page(not cover)."
msgstr "Ako serijal nije pronađen, ubacite calibre serijal (ako postoji) tako \nda se pojavi na FanFicFare naslovnoj strani (ne na koricama)."

#: config.py:667
msgid "Search by Title/Author(s) for If Story Already Exists?"
msgstr "Pretražiti po Naslovu/Autoru(ima) za Ako priča već postoji?"

#: config.py:668
msgid ""
"When checking <i>If Story Already Exists</i> FanFicFare will first match by "
"URL Identifier.  But if not found, it can also search existing books by "
"Title and Author(s)."
msgstr "Prilikom provere <i>Ako priča već postoji</i> FanFicFare će prvo tražiti podudaranje po URL identifikatoru. Ali ako nije pronađen, može pretraživati i postojeće knjige po Naslovu i Autoru(ima)."

#: config.py:672
msgid "Reject List"
msgstr "Lista odbijenih"

#: config.py:676
msgid "Edit Reject URL List"
msgstr "Uredi listu odbijenih URL-ova"

#: config.py:677
msgid "Edit list of URLs FanFicFare will automatically Reject."
msgstr "Uredite listu URL-ova koje će FanFicFare automatski odbiti."

#: config.py:681 config.py:760 fff_plugin.py:418 fff_plugin.py:421
msgid "Add Reject URLs"
msgstr "Dodaj odbijene URL-ove"

#: config.py:682
msgid "Add additional URLs to Reject as text."
msgstr "Dodajte dodatne URL-ove za odbijanje kao tekst."

#: config.py:686
msgid "Edit Reject Reasons List"
msgstr "Uredi listu razloga za odbijanje"

#: config.py:687 config.py:750
msgid "Customize the Reasons presented when Rejecting URLs"
msgstr "Prilagodite razloge predstavljene prilikom odbijanja URL-ova"

#: config.py:692
msgid "Always reject URLs on the Reject List without stopping and asking."
msgstr "Uvek odbijte URL-ove na Listi odbijenih bez zaustavljanja i pitanja."

#: config.py:696
msgid "Delete on Reject by Default?"
msgstr "Izbrisati pri odbijanju podrazumevano?"

#: config.py:697
msgid "Should the checkbox to delete Rejected books be checked by default?"
msgstr "Da li polje za potvrdu za brisanje odbijenih knjiga treba da bude označeno podrazumevano?"

#: config.py:735 fff_plugin.py:507
msgid "Edit Reject URLs List"
msgstr "Uredi listu odbijenih URL-ova"

#: config.py:748
msgid "Reject Reasons"
msgstr "Razlozi za odbijanje"

#: config.py:749
msgid "Customize Reject List Reasons"
msgstr "Prilagodi razloge liste odbijenih"

#: config.py:758 fff_plugin.py:489
msgid "Reason why I rejected it"
msgstr "Razlog zašto sam ga odbio"

#: config.py:758 fff_plugin.py:489
msgid "Title by Author"
msgstr "Naslov od Autora"

#: config.py:761 fff_plugin.py:492
msgid ""
"Add Reject URLs. Use: <b>http://...,note</b> or <b>http://...,title by "
"author - note</b><br>Invalid story URLs will be ignored."
msgstr "Dodaj URL-ove za odbijanje. Koristi: <b>http://...,note</b> ili <b>http://...,title by author - note</b><br>Nevažeći URL-ovi priča biće zanemareni."

#: config.py:762 fff_plugin.py:493
msgid ""
"One URL per line:\n"
"<b>http://...,note</b>\n"
"<b>http://...,title by author - note</b>"
msgstr "Jedan URL po redu:\n<b>http://...,note</b>\n<b>http://...,title by author - note</b>"

#: config.py:764 dialogs.py:1369 fff_plugin.py:495
msgid "Add this reason to all URLs added:"
msgstr "Dodaj ovaj razlog svim dodatim URL-ovima:"

#: config.py:784
msgid ""
"These settings provide more detailed control over what metadata will be "
"displayed inside the ebook as well as let you set %(isa)s and %(u)s/%(p)s "
"for different sites."
msgstr "Ova podešavanja pružaju detaljniju kontrolu nad tim koji metapodaci će biti prikazani unutar e-knjige, kao i omogućavaju vam da postavite %(isa)s i %(u)s/%(p)s za različite sajtove."

#: config.py:792
msgid "personal.ini"
msgstr "personal.ini"

#: config.py:799 config.py:997 config.py:998 fff_plugin.py:432
#: fff_plugin.py:435 fff_plugin.py:471
msgid "Edit personal.ini"
msgstr "Uredi personal.ini"

#: config.py:804
msgid ""
"FanFicFare now includes find, color coding, and error checking for "
"personal.ini editing.  Red generally indicates errors."
msgstr "FanFicFare sada uključuje pronalaženje, kodiranje bojama i proveru grešaka za uređivanje personal.ini. Crvena boja generalno ukazuje na greške."

#: config.py:812
msgid "View \"Safe\" personal.ini"
msgstr "Prikaži \"Bezbedan\" personal.ini"

#: config.py:817 config.py:988
msgid ""
"View your personal.ini with usernames and passwords removed.  For safely "
"sharing your personal.ini settings with others."
msgstr "Prikažite svoj personal.ini sa uklonjenim korisničkim imenima i lozinkama. Za bezbedno deljenje vaših personal.ini podešavanja sa drugima."

#: config.py:823
msgid "INI Snippets"
msgstr "INI isečci"

#: config.py:828
msgid ""
"Manage saved INI snippets that can be applied to individual download "
"sessions."
msgstr "Upravljajte sačuvanim INI isečcima koji se mogu primeniti na pojedinačne sesije preuzimanja."

#: config.py:842 fff_plugin.py:1461 jobs.py:95
msgid "Add"
msgstr "Dodaj"

#: config.py:852
msgid "Remove"
msgstr "Ukloni"

#: config.py:859
msgid "defaults.ini"
msgstr "defaults.ini"

#: config.py:864
msgid ""
"View all of the plugin's configurable settings\n"
"and their default settings."
msgstr "Prikažite sva konfigurabilna podešavanja dodatka\ni njihova podrazumevana podešavanja."

#: config.py:865
msgid "View Defaults"
msgstr "Prikaži podrazumevano"

#: config.py:876
msgid "Calibre Columns"
msgstr "Calibre kolone"

#: config.py:883
