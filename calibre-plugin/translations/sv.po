msgid ""
"When an update or overwrite of an existing story fails, record the reason in this column.\n"
"(Text and Long Text columns only.)"
msgstr "När en uppdatering eller överskrivning av en befintlig berättelse misslyckas sparas orsaken i denna kolumn.\n(Endast kolumner av typen Text och Lång text.)"

#: config.py:1604
